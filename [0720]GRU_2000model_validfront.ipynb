      "cell_type": "markdown",
      "source": [
        "##(참고용)Data Windows\n",
        "* 예측 시점 하루 -> 15일 예측\n",
        "* target에 따라 두가지 버전\n"
      ],
      "metadata": {
        "id": "pJ-_avp0m_FM"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def get_target_for_single_stock(data):\n",
        "    df = data.copy()\n",
        "    df['target'] = df['Close'].shift(-15).fillna(method='ffill')  # NaN 값을 먼저 채웁니다.\n",
        "    df['target'] = df['target'].round(0).astype(int)  # 소수점을 제거합니다.\n",
        "\n",
        "    return df\n",
        "\n",
        "def get_target_for_all_stocks(data):\n",
        "    # 데이터 프레임을 종목별로 분리합니다.\n",
        "    grouped_data = data.groupby('StockCode')\n",
        "\n",
        "    # 각 종목별로 `get_target_for_single_stock` 함수를 적용합니다.\n",
        "    dfs_with_target = [get_target_for_single_stock(group) for _, group in grouped_data]\n",
        "\n",
        "    # 처리된 데이터 프레임들을 하나로 합칩니다.\n",
        "    combined_data = pd.concat(dfs_with_target, ignore_index=True)\n",
        "    return combined_data"
      ],
      "metadata": {
        "id": "RKcldCxzsZQ9"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "data_with_target = get_target_for_all_stocks(df)\n",
        "\n",
        "data_with_target\n"
      ],

        "###(참고용) LSTM"
      ],
      "metadata": {
        "id": "zussnL-4AFIb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
        "torch.manual_seed(1)\n",
        "if device == 'cuda':\n",
        "    torch.cuda.manual_seed_all(1)"
      ],
      "metadata": {
        "id": "AbS5SO1ilnWi"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "class myGRU(nn.Module):\n",
        "    def __init__(self, input_size, hidden_size, num_layers):\n",
        "        super(myGRU, self).__init__()\n",
        "        self.hidden_size = hidden_size\n",
        "        self.num_layers = num_layers\n",
        "        self.gru = nn.GRU(input_size, hidden_size, num_layers, batch_first=True, bias = True, dropout = 0.25)\n",
        "        self.fc1 = nn.Linear(hidden_size, 64)\n",
        "        self.fc = nn.Linear(64, 1)\n",
        "        self.tanh = nn.Tanh()\n",
        "        self.dropout = nn.Dropout(0.25)\n",
        "\n",
        "    def forward(self, x):\n",
        "        h0 = torch.zeros(self.num_layers, x.shape[0], self.hidden_size).to(device)\n",
        "        output, (hn) = self.gru(x, (h0))\n",
        "        hn = hn.view(-1, self.hidden_size)\n",
        "        out = self.tanh(hn)\n",
        "        out = self.fc1(out)\n",
        "        out = self.tanh(out)\n",
        "        out = self.dropout(out)\n",
        "        out = self.fc(out)\n",
        "        return out"
      ],
      "metadata": {
        "id": "mkTcc29plvca"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
